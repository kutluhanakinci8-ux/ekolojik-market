{
  "name": "ekolojik-market-pos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "npm run images:sync && tsc -b && vite build",
    "images:sync": "node scripts/download-product-images.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5180",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-5180}",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "scrape:greenleaf": "node scripts/scrape-greenleaf.mjs",
    "scrape:greenleaf-shop": "node scripts/scrape-greenleaf-shop.mjs",
