    "repair:greenleaf-shop-tr": "node scripts/repair-greenleaf-shop-tr.mjs"
  },
  "dependencies": {
    "imapflow": "^1.7.8",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@iamtraction/google-translate": "^2.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
