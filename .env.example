# Ekolojik Market POS — ortam değişkenleri (örnek)

# Bağımsız giden posta (Faz 1) — Nakliye Borsası ile paylaşılmaz
EKOLOJIK_SMTP_HOST=mail.ekolojikmarket.com.tr
EKOLOJIK_SMTP_PORT=587
# EKOLOJIK_SMTP_SECURE=1
EKOLOJIK_SMTP_USER=
EKOLOJIK_SMTP_PASS=
EKOLOJIK_MAIL_FROM=bildirim@ekolojikmarket.com.tr
EKOLOJIK_MAIL_FROM_NAME=Ekolojik Market
# EKOLOJIK_MAIL_REPLY_TO=info@ekolojikmarket.com.tr

# Faz 2 — iletişim formu operasyon bildirimi
EKOLOJIK_OPS_EMAIL=info@ekolojikmarket.com.tr
# EKOLOJIK_CONTACT_AUTOREPLY=1

# Faz 3 — mesajlaşma e-posta özeti (ops: müşteri yönü mesaj; müşteri: mağaza yönü)
# EKOLOJIK_MESSAGING_CUSTOMER_EMAIL=1

# NB ortak API köprüsü — üretimde kapalı
LERTA_PLATFORM_BRIDGE=0
# LERTA_PLATFORM_API_URL=
# LERTA_MAIL_API_KEY=

PORT=5180
