# Ekolojik Market POS — ortam değişkenleri (örnek)

# Bağımsız giden posta (Faz 1) — Nakliye Borsası ile paylaşılmaz
# Aynı VPS'te Postfix varsa (Faz 6): 127.0.0.1 + port 25 — scripts/sunucu-ekolojik-postfix-yerel-relay-kur.sh
# EKOLOJIK_SMTP_HOST=127.0.0.1
# EKOLOJIK_SMTP_PORT=25
EKOLOJIK_SMTP_HOST=mail.ekolojikmarket.com.tr
EKOLOJIK_SMTP_PORT=587
# EKOLOJIK_SMTP_SECURE=1
EKOLOJIK_SMTP_USER=
EKOLOJIK_SMTP_PASS=
EKOLOJIK_MAIL_FROM=bildirim@ekolojikmarket.com.tr
EKOLOJIK_MAIL_FROM_NAME="Ekolojik Market"
EKOLOJIK_MAIL_REPLY_TO=info@ekolojikmarket.com.tr

# Faz 2 — iletişim formu operasyon bildirimi
EKOLOJIK_OPS_EMAIL=info@ekolojikmarket.com.tr
# Müşteri iletişim formu otomatik alındı (önerilen prod: 1)
# EKOLOJIK_CONTACT_AUTOREPLY=1

# Faz 3 — mesajlaşma e-posta özeti (ops: müşteri yönü mesaj; müşteri: mağaza yönü)
# EKOLOJIK_MESSAGING_CUSTOMER_EMAIL=1

# Site / widget public API (tenant anahtarı yoksa fallback)
# EKOLOJIK_MESSAGING_PUBLIC_KEY=

# Posta deliverability + onboarding alias listesi (virgülle)
# EKOLOJIK_MAIL_DOMAIN=ekolojikmarket.com.tr
# EKOLOJIK_MAIL_ALIASES=siparis@ekolojikmarket.com.tr,fatura@ekolojikmarket.com.tr,destek@ekolojikmarket.com.tr

# Faz 4 — gelen fatura e-postası (IMAP, Ekolojik-only)
# EKOLOJIK_IMAP_HOST=imap.gmail.com
# EKOLOJIK_IMAP_PORT=993
# EKOLOJIK_IMAP_SECURE=1
# EKOLOJIK_IMAP_USER=
# EKOLOJIK_IMAP_PASS=
# EKOLOJIK_IMAP_INBOX=

# Platform destek@ (ayrı posta kutusu — scripts/sunucu-ekolojik-destek-mailbox.sh)
# EKOLOJIK_SUPPORT_MAIL_FROM=destek@ekolojikmarket.com.tr
# EKOLOJIK_SUPPORT_MAIL_FROM_NAME=Ekolojik Destek
# EKOLOJIK_SUPPORT_INBOX=destek@ekolojikmarket.com.tr
# EKOLOJIK_SUPPORT_IMAP_HOST=127.0.0.1
# EKOLOJIK_SUPPORT_IMAP_USER=destek@ekolojikmarket.com.tr
# EKOLOJIK_SUPPORT_IMAP_PASS=
# new_case spawn sonrası ops@ iç bildirimi (varsayılan açık; 0 veya false ile kapat)
# EKOLOJIK_SUPPORT_ALERT_CASE=1
# EKOLOJIK_SUPPORT_SLA_AUTO_APOLOGY=1
# EKOLOJIK_SUPPORT_SLA_AUTO_APOLOGY_MAX=5
# CRM SMS: mock | netgsm | http
# EKOLOJIK_SMS_PROVIDER=mock
# EKOLOJIK_SMS_USER=
# EKOLOJIK_SMS_PASS=
# EKOLOJIK_SMS_HEADER=
# EKOLOJIK_SMS_HTTP_URL=https://sms.example/send?phone={phone}&text={message}
# EKOLOJIK_ZENDESK_WEBHOOK_SECRET=
# Güvenlik eşik uyarısı → platform destek incident case (otomatik)
# EKOLOJIK_SUPPORT_OPS_NOTIFY=1
# Cron sonrası SLA/kuyruk özeti ops@ (varsayılan açık; 4 saatte bir tekrar, durum değişince hemen)
# EKOLOJIK_SUPPORT_OPS_SLA_NOTIFY=1
# Cron IMAP senkron hatasında ops@ (varsayılan: ops notify açıksa açık; saatte max 1 mail)
# EKOLOJIK_SUPPORT_IMAP_SYNC_ALERT=1
# Zendesk köprüsü (platform destek kaydı ↔ ticket)
# EKOLOJIK_ZENDESK_SUBDOMAIN=ekolojikmarket
# EKOLOJIK_ZENDESK_WEBHOOK_SECRET=
# Webhook URL (Zendesk trigger): POST https://<site>/api/platform/support/zendesk/webhook
# Header: X-Zendesk-Webhook-Secret veya Authorization: Bearer <secret>
# EKOLOJIK_ZENDESK_API_EMAIL=agent@ekolojikmarket.com.tr
# EKOLOJIK_ZENDESK_API_TOKEN=
# İsteğe bağlı: webhook’ta kayıt numarası için Zendesk özel alan ID
# EKOLOJIK_ZENDESK_CASE_NUMBER_FIELD_ID=
# destek@ otomatik yanıt / spawn mail footer (prod VPS .env — tam URL kullanın)
# EKOLOJIK_MAIL_LOGO_URL=https://www.ekolojikmarket.com.tr/brand/ekolojik-email-logo.svg
# EKOLOJIK_CONTACT_FORM_URL=https://www.ekolojikmarket.com.tr/iletisim
# Sosyal: boş bırakılan kanal footer'da listelenmez (örnek format)
# EKOLOJIK_SOCIAL_INSTAGRAM=https://www.instagram.com/<hesap>/
# EKOLOJIK_SOCIAL_FACEBOOK=https://www.facebook.com/<sayfa>/
# EKOLOJIK_SOCIAL_YOUTUBE=https://www.youtube.com/@<kanal>
# EKOLOJIK_SOCIAL_LINKEDIN=https://www.linkedin.com/company/<slug>/
# EKOLOJIK_SOCIAL_X=https://x.com/<hesap>
# Spam/çöp işlemlerini sunucuda MOVE et (1=aktif, varsayılan kapalı)
# EKOLOJIK_IMAP_WRITE=0

# Faz 5 — saklama (gün)
# EKOLOJIK_OUTBOX_RETENTION_DAYS=90
# EKOLOJIK_MESSAGING_RETENTION_DAYS=365
# EKOLOJIK_CONTACT_RETENTION_DAYS=730

# NB ortak API köprüsü — üretimde kapalı
LERTA_PLATFORM_BRIDGE=0
# LERTA_PLATFORM_API_URL=
# LERTA_MAIL_API_KEY=

# POS yönetim API (onboarding, tenant-mail, messaging rotate) — üretimde sabit secret önerilir
# EKOLOJIK_POS_API_SECRET=

# Greenleaf main tenant — şifreler repoda tutulmaz (scripts/ensure-greenleaf-credentials.mjs)
# GREENLEAF_OWNER_PASSWORD=
# GREENLEAF_OWNER_RECOVERY_EMAIL=...  # kutluhan08 şifre sıfırlama (alıcı)
# GREENLEAF_DEMO_ADMIN_PASSWORD=
# GREENLEAF_DEMO_CASHIER_PASSWORD=
# EKOLOJIK_PUBLIC_BASE_URL=https://www.ekolojikmarket.com.tr

PORT=5180
