# Greenleaf yerel masaüstü — .env olarak kopyalayın: cp .env.greenleaf.example .env

PORT=5190
HOST=127.0.0.1
NODE_ENV=production

# Veri bu klasörde (mutlak yol da verilebilir)
MARKET_POS_DATA_DIR=./data

# Yerel köken (API / yönlendirme)
EKOLOJIK_PUBLIC_ORIGIN=http://127.0.0.1:5190

# Masaüstü modu (ileride route kısıtları)
GREENLEAF_DESKTOP=1

# Bulut posta / platform — yerelde kapalı tutun
LERTA_PLATFORM_BRIDGE=0
